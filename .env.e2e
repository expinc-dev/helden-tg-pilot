VITE_MODE=e2e
VITE_USE_FIREBASE_EMULATOR=true

# "demo-" prefix = Firebase emulator's offline demo project, no real GCP project
# or credentials needed. These values are never sent anywhere real.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-e2e-test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-e2e-test
VITE_FIREBASE_STORAGE_BUCKET=demo-e2e-test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-e2e-test
